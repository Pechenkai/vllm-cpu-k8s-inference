{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"private": {"()": "app.private_logging.SafeFormatter"}},
  "handlers": {"private": {"class": "app.private_logging.SafeHandler", "formatter": "private"}},
  "root": {"handlers": ["private"], "level": "INFO"},
  "loggers": {
    "vllm": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "uvicorn": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "CRITICAL", "propagate": false},
    "private_audit": {"handlers": ["private"], "level": "INFO", "propagate": false}
  }
}
